      { nome: "Ovos pochê com abacate", ing: "Ovos, abacate, limão, sal", prep: "Escalfe os ovos em água quente com vinagre por 3 min. Sirva sobre o abacate amassado com limão." }
    ]},
    camarao: { label: "🍤 Camarão", items: [
      { nome: "Camarão ao alho e limão", ing: "Camarão, alho picado, limão, azeite, sal", prep: "Salteie em fogo alto por 2-3 min de cada lado, sem passar do ponto." },
      { nome: "Camarão na chapa com páprica", ing: "Camarão, páprica, azeite, sal", prep: "Tempere e grelhe rapidamente em fogo alto até ficar rosado." },
      { nome: "Camarão ao curry leve", ing: "Camarão, curry em pó, leite de coco, azeite", prep: "Salteie o camarão, adicione curry e leite de coco, cozinhe por 5 min." }
    ]},
    atum: { label: "🐟 Atum", items: [
      { nome: "Atum temperado com limão e cebola", ing: "Atum em lata, limão, cebola picada, azeite, sal", prep: "Escorra o atum e misture com os temperos." },
      { nome: "Atum com maçã picada", ing: "Atum em lata, maçã picada, iogurte natural, sal", prep: "Misture tudo para uma versão levemente adocicada." }
    ]},
    vegetariano: { label: "🧀 Vegetariana", items: [
      { nome: "Queijo minas grelhado", ing: "Queijo minas em postas, orégano, azeite", prep: "Grelhe as postas em fogo médio até dourar dos dois lados." },
      { nome: "Grão-de-bico temperado", ing: "Grão-de-bico cozido, cominho, páprica, azeite, limão, sal", prep: "Misture todos os ingredientes e sirva frio ou levemente salteado." }
    ]}
  };

  function buildProteinasTab(){
    var box = document.getElementById('proteinas-content');
    if(!box) return;
    var html = '';
    Object.keys(PROTEIN_RECIPES).forEach(function(k){
      var grupo = PROTEIN_RECIPES[k];
      html += '<div class="protein-group"><h3>' + grupo.label + '</h3>';
      grupo.items.forEach(function(r){
        html += '<details class="protein-recipe"><summary>' + r.nome + '</summary>' +
          '<div class="pr-body">' +
          '<div class="item"><b>Ingredientes:</b> ' + r.ing + '</div>' +
          '<div class="item"><b>Modo de preparo:</b> ' + r.prep + '</div>' +
          '</div></details>';
      });
      html += '</div>';
    });
    box.innerHTML = html;
  }

  function showTab(name){
    document.getElementById('tab-desafio').style.display = (name === 'desafio') ? '' : 'none';
    document.getElementById('tab-receitas').style.display = (name === 'receitas') ? '' : 'none';
    document.getElementById('tab-todas').style.display = (name === 'todas') ? '' : 'none';
    document.getElementById('tab-hoje').style.display = (name === 'hoje') ? '' : 'none';
    document.getElementById('tab-proteinas').style.display = (name === 'proteinas') ? '' : 'none';
    document.getElementById('btn-tab-desafio').classList.toggle('active', name === 'desafio');
    document.getElementById('btn-tab-receitas').classList.toggle('active', name === 'receitas');
    document.getElementById('btn-tab-todas').classList.toggle('active', name === 'todas');
    document.getElementById('btn-tab-hoje').classList.toggle('active', name === 'hoje');
    document.getElementById('btn-tab-proteinas').classList.toggle('active', name === 'proteinas');
    if(name === 'hoje' && typeof buildHojeTab === 'function') buildHojeTab();
  }
</script>
<script>
(function(){
  var DB_URL = 'https://desafio21-37862-default-rtdb.firebaseio.com/desafio';
  var badge = document.getElementById('sync-badge');
  var applyingRemote = false;

  function getInputs(){
    return Array.prototype.slice.call(document.querySelectorAll('input[id], select[id]'));
  }

  function setBadge(text, offline){
    badge.textContent = text;
    badge.classList.toggle('offline', !!offline);
  }

  function applyValue(el, val){
    if(val === undefined || val === null) return;
    if(el.type === 'checkbox') {
      el.checked = !!val;
      if(el.closest && el.closest('.chip')) el.closest('.chip').classList.toggle('checked', el.checked);
    }
    else el.value = val;
    if(el.tagName === 'SELECT' && el.dataset && el.dataset.role === 'molho' && typeof renderMolhoDetail === 'function'){
      renderMolhoDetail(el.dataset.day);
    }
  }

  function applyData(data){
    if(!data) return;
    applyingRemote = true;
    getInputs().forEach(function(el){
      if(data[el.id] !== undefined) applyValue(el, data[el.id]);
    });
    applyingRemote = false;
    updateProgress();
  }

  function loadInitial(){
    setBadge('🔄 Sincronizando...', false);
    fetch(DB_URL + '.json')
      .then(function(r){ return r.json(); })
      .then(function(data){
        applyData(data);
        setBadge('✅ Sincronizado com Juliana/Elline', false);
      })
      .catch(function(){ setBadge('⚠️ Sem conexão — salvando só aqui', true); });
  }

  function saveField(id, value){
    fetch(DB_URL + '/' + id + '.json', {
      method: 'PUT',
      body: JSON.stringify(value)
    }).then(function(){
      setBadge('✅ Sincronizado com Juliana/Elline', false);
    }).catch(function(){
      setBadge('⚠️ Sem conexão — tentando de novo...', true);
    });
  }

  function listenRealtime(){
    try {
      var es = new EventSource(DB_URL + '.json');
      es.addEventListener('put', function(e){
        try {
          var payload = JSON.parse(e.data);
          if(payload.path === '/'){
            applyData(payload.data);
          } else {
            var id = payload.path.replace('/', '');
            var el = document.getElementById(id);
            if(el){ applyingRemote = true; applyValue(el, payload.data); applyingRemote = false; updateProgress(); }
          }
        } catch(err){}
      });
      es.addEventListener('patch', function(e){
        try {
          var payload = JSON.parse(e.data);
          applyingRemote = true;
          Object.keys(payload.data || {}).forEach(function(key){
            var el = document.getElementById(key);
            if(el) applyValue(el, payload.data[key]);
          });
          applyingRemote = false;
          updateProgress();
        } catch(err){}
      });
      es.onerror = function(){ setBadge('⚠️ Reconectando...', true); };
    } catch(err){ /* navegador sem suporte a EventSource */ }
  }

  function pct(done, total){ return total ? Math.round(done/total*100) : 0; }

  var WEEK_RANGES = { 1: [1,7], 2: [8,14], 3: [15,21] };

  function updateWeeklyPoints(){
    Object.keys(WEEK_RANGES).forEach(function(w){
      var range = WEEK_RANGES[w];
      var box = document.getElementById('week' + w + '-pontos-auto');
      if(!box) return;
      var pontos = { e: 0, j: 0 };
      for(var day = range[0]; day <= range[1]; day++){
        ['e','j'].forEach(function(who){
          var t = document.getElementById('d' + day + '-' + who + '-treino');
          var d = document.getElementById('d' + day + '-' + who + '-dieta');
          if(t && t.checked) pontos[who]++;
          if(d && d.checked) pontos[who]++;
        });
      }
      var lead = '';
      if(pontos.e !== pontos.j){
        lead = '<span class="lead">' + (pontos.e > pontos.j ? '🧡 Elline na frente' : '💚 Juliana na frente') + '</span>';
      } else {
        lead = '<span class="lead">🤝 empate</span>';
      }
      box.innerHTML = '<span class="e">Elline: ' + pontos.e + '</span> &nbsp;·&nbsp; <span class="j">Juliana: ' + pontos.j + '</span>' + lead;
    });
  }

  function updateProgress(){
    var all = document.querySelectorAll('input[type=checkbox][data-day]');
    var totalAll = all.length, doneAll = 0;
    all.forEach(function(el){ if(el.checked) doneAll++; });
    document.getElementById('progress-all-bar').style.width = pct(doneAll, totalAll) + '%';
    document.getElementById('progress-all-label').textContent = pct(doneAll, totalAll) + '%';

    ['e','j'].forEach(function(who){
      var els = document.querySelectorAll('input[type=checkbox][data-who="' + who + '"]');
      var t = els.length, d = 0;
      els.forEach(function(el){ if(el.checked) d++; });
      document.getElementById('progress-' + who + '-bar').style.width = pct(d, t) + '%';
      document.getElementById('progress-' + who + '-label').textContent = pct(d, t) + '%';
    });

    updateWeeklyPoints();
    if(typeof buildHojeTab === 'function') buildHojeTab();
  }

  document.addEventListener('DOMContentLoaded', function(){
    if(typeof buildRecipeDays === 'function') buildRecipeDays();
    if(typeof buildTodasReceitas === 'function') buildTodasReceitas();
    if(typeof buildProteinasTab === 'function') buildProteinasTab();
    if(typeof buildHojeTab === 'function') buildHojeTab();
    loadInitial();
    listenRealtime();
    getInputs().forEach(function(el){
      el.addEventListener('change', function(){
        if(applyingRemote) return;
        var value = el.type === 'checkbox' ? el.checked : el.value;
        saveField(el.id, value);
        if(el.type === 'checkbox' && el.closest && el.closest('.chip')){
          el.closest('.chip').classList.toggle('checked', el.checked);
        }
        if(el.tagName === 'SELECT' && el.dataset && el.dataset.role === 'molho' && typeof renderMolhoDetail === 'function'){
          renderMolhoDetail(el.dataset.day);
        }
        updateProgress();
      });
    });
  });
})();
</script>
</body>
</html>
