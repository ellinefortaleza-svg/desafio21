    items.forEach(function(item){
      var key = slugify(item);
      var id = 'd-' + dayId + '-' + groupKey + '-' + key;
      html += '<label class="chip" for="' + id + '"><input type="checkbox" id="' + id + '"><span>' + item + '</span></label>';
    });
    html += '</div>';
    return html;
  }

  function selectGroup(dayId, groupKey, items, label, extraAttrs){
    var id = 'd-' + dayId + '-' + groupKey;
    var html = '<div class="block-label">' + label + '</div><select id="' + id + '" ' + (extraAttrs||'') + '><option value="">— escolher —</option>';
    items.forEach(function(item){
      html += '<option value="' + item + '">' + item + '</option>';
    });
    html += '</select>';
    return html;
  }

  function molhoSelect(dayId){
    var id = 'd-' + dayId + '-molho';
    var html = '<div class="block-label">6º · Adicione 1 molho</div><select id="' + id + '" data-day="' + dayId + '" data-role="molho"><option value="">— escolher —</option>';
    Object.keys(MOLHOS).forEach(function(k){
      html += '<option value="' + k + '">' + MOLHOS[k].nome + '</option>';
    });
    html += '</select><div class="molho-detail" id="molho-detail-' + dayId + '"></div>';
    return html;
  }

  function renderMolhoDetail(dayId){
    var sel = document.getElementById('d-' + dayId + '-molho');
    var box = document.getElementById('molho-detail-' + dayId);
    if(!sel || !box) return;
    var m = MOLHOS[sel.value];
    if(!m){ box.innerHTML = ''; return; }
    box.innerHTML = '<div class="item"><b>Ingredientes:</b> ' + m.ing + '</div><div class="item"><b>Preparo:</b> ' + m.prep + '</div>';
  }

  function buildRecipeDays(){
    var container = document.getElementById('recipe-days');
    var html = '';
    WEEK_DAYS.forEach(function(d){
      html += '<div class="recipe-day-card">';
      html += '<div class="rd-top"><span class="rd-day">' + d.label + '</span></div>';
      html += chipGroup(d.id, 'folha', FOLHOSOS, '1º · Escolha no mínimo 2 vegetais folhosos');
      html += chipGroup(d.id, 'veg', VEGETAIS, '2º · Escolha no mínimo 2 vegetais, legumes ou grãos crus');
      html += chipGroup(d.id, 'doce', DOCES, '3º · Sabor extra (opcional): crocante ou doce');
      html += selectGroup(d.id, 'proteina', PROTEINAS, '4º · Adicione 1 proteína');
      html += chipGroup(d.id, 'extra', EXTRAS, '5º · Adicione extras (opcional)');
      html += molhoSelect(d.id);
      html += '</div>';
    });
    container.innerHTML = html;
    WEEK_DAYS.forEach(function(d){ renderMolhoDetail(d.id); });
  }

  function buildTodasReceitas(){
    function fillChips(containerId, items){
      var el = document.getElementById(containerId);
      if(!el) return;
      el.innerHTML = items.map(function(i){ return '<span class="chip">' + i + '</span>'; }).join('');
    }
    fillChips('ref-folhosos', FOLHOSOS);
    fillChips('ref-vegetais', VEGETAIS);
    fillChips('ref-doces', DOCES);
    fillChips('ref-proteinas', PROTEINAS);
    fillChips('ref-extras', EXTRAS);

    var box = document.getElementById('ref-molhos');
    if(box){
      var html = '';
      Object.keys(MOLHOS).forEach(function(k){
        var m = MOLHOS[k];
        html += '<div class="molho-card">' +
          '<div class="mc-nome">' + m.nome + '</div>' +
          '<div class="item"><b>Ingredientes:</b> ' + m.ing + '</div>' +
          '<div class="item"><b>Preparo:</b> ' + m.prep + '</div>' +
          '</div>';
      });
      box.innerHTML = html;
    }
  }

  function showTab(name){
    document.getElementById('tab-desafio').style.display = (name === 'desafio') ? '' : 'none';
    document.getElementById('tab-receitas').style.display = (name === 'receitas') ? '' : 'none';
    document.getElementById('tab-todas').style.display = (name === 'todas') ? '' : 'none';
    document.getElementById('btn-tab-desafio').classList.toggle('active', name === 'desafio');
    document.getElementById('btn-tab-receitas').classList.toggle('active', name === 'receitas');
    document.getElementById('btn-tab-todas').classList.toggle('active', name === 'todas');
  }
</script>
<script>
(function(){
  var DB_URL = 'https://desafio21-37862-default-rtdb.firebaseio.com/desafio';
  var badge = document.getElementById('sync-badge');
  var applyingRemote = false;

  function getInputs(){
    return Array.prototype.slice.call(document.querySelectorAll('input[id], select[id]'));
  }

  function setBadge(text, offline){
    badge.textContent = text;
    badge.classList.toggle('offline', !!offline);
  }

  function applyValue(el, val){
    if(val === undefined || val === null) return;
    if(el.type === 'checkbox') {
      el.checked = !!val;
      if(el.closest && el.closest('.chip')) el.closest('.chip').classList.toggle('checked', el.checked);
    }
    else el.value = val;
    if(el.tagName === 'SELECT' && el.dataset && el.dataset.role === 'molho' && typeof renderMolhoDetail === 'function'){
      renderMolhoDetail(el.dataset.day);
    }
  }

  function applyData(data){
    if(!data) return;
    applyingRemote = true;
    getInputs().forEach(function(el){
      if(data[el.id] !== undefined) applyValue(el, data[el.id]);
    });
    applyingRemote = false;
    updateProgress();
  }

  function loadInitial(){
    setBadge('🔄 Sincronizando...', false);
    fetch(DB_URL + '.json')
      .then(function(r){ return r.json(); })
      .then(function(data){
        applyData(data);
        setBadge('✅ Sincronizado com Juliana/Elline', false);
      })
      .catch(function(){ setBadge('⚠️ Sem conexão — salvando só aqui', true); });
  }

  function saveField(id, value){
    fetch(DB_URL + '/' + id + '.json', {
      method: 'PUT',
      body: JSON.stringify(value)
    }).then(function(){
      setBadge('✅ Sincronizado com Juliana/Elline', false);
    }).catch(function(){
      setBadge('⚠️ Sem conexão — tentando de novo...', true);
    });
  }

  function listenRealtime(){
    try {
      var es = new EventSource(DB_URL + '.json');
      es.addEventListener('put', function(e){
        try {
          var payload = JSON.parse(e.data);
          if(payload.path === '/'){
            applyData(payload.data);
          } else {
            var id = payload.path.replace('/', '');
            var el = document.getElementById(id);
            if(el){ applyingRemote = true; applyValue(el, payload.data); applyingRemote = false; updateProgress(); }
          }
        } catch(err){}
      });
      es.addEventListener('patch', function(e){
        try {
          var payload = JSON.parse(e.data);
          applyingRemote = true;
          Object.keys(payload.data || {}).forEach(function(key){
            var el = document.getElementById(key);
            if(el) applyValue(el, payload.data[key]);
          });
          applyingRemote = false;
          updateProgress();
        } catch(err){}
      });
      es.onerror = function(){ setBadge('⚠️ Reconectando...', true); };
    } catch(err){ /* navegador sem suporte a EventSource */ }
  }

  function pct(done, total){ return total ? Math.round(done/total*100) : 0; }

  function updateProgress(){
    var all = document.querySelectorAll('input[type=checkbox][data-day]');
    var totalAll = all.length, doneAll = 0;
    all.forEach(function(el){ if(el.checked) doneAll++; });
    document.getElementById('progress-all-bar').style.width = pct(doneAll, totalAll) + '%';
    document.getElementById('progress-all-label').textContent = pct(doneAll, totalAll) + '%';

    ['e','j'].forEach(function(who){
      var els = document.querySelectorAll('input[type=checkbox][data-who="' + who + '"]');
      var t = els.length, d = 0;
      els.forEach(function(el){ if(el.checked) d++; });
      document.getElementById('progress-' + who + '-bar').style.width = pct(d, t) + '%';
      document.getElementById('progress-' + who + '-label').textContent = pct(d, t) + '%';
    });
  }

  document.addEventListener('DOMContentLoaded', function(){
    if(typeof buildRecipeDays === 'function') buildRecipeDays();
    if(typeof buildTodasReceitas === 'function') buildTodasReceitas();
    loadInitial();
    listenRealtime();
    getInputs().forEach(function(el){
      el.addEventListener('change', function(){
        if(applyingRemote) return;
        var value = el.type === 'checkbox' ? el.checked : el.value;
        saveField(el.id, value);
        if(el.type === 'checkbox' && el.closest && el.closest('.chip')){
          el.closest('.chip').classList.toggle('checked', el.checked);
        }
        if(el.tagName === 'SELECT' && el.dataset && el.dataset.role === 'molho' && typeof renderMolhoDetail === 'function'){
          renderMolhoDetail(el.dataset.day);
        }
        updateProgress();
      });
    });
  });
})();
</script>
</body>
</html>
